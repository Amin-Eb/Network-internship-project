        -:   23:namespace prometheus {
        -:   24:
        -:   25:/// \brief A metric of type T with a set of labeled dimensions.
        -:   26:///
        -:   27:/// One of Prometheus main feature is a multi-dimensional data model with time
        -:   28:/// series data identified by metric name and key/value pairs, also known as
        -:   29:/// labels. A time series is a series of data points indexed (or listed or
        -:   30:/// graphed) in time order (https://en.wikipedia.org/wiki/Time_series).
        -:   31:///
        -:   32:/// An instance of this class is exposed as multiple time series during
        -:   33:/// scrape, i.e., one time series for each set of labels provided to Add().
        -:   34:///
        -:   35:/// For example it is possible to collect data for a metric
        -:   36:/// `http_requests_total`, with two time series:
        -:   37:///
        -:   38:/// - all HTTP requests that used the method POST
        -:   39:/// - all HTTP requests that used the method GET
        -:   40:///
        -:   41:/// The metric name specifies the general feature of a system that is
        -:   42:/// measured, e.g., `http_requests_total`. Labels enable Prometheus's
        -:   43:/// dimensional data model: any given combination of labels for the same
        -:   44:/// metric name identifies a particular dimensional instantiation of that
        -:   45:/// metric. For example a label for 'all HTTP requests that used the method
        -:   46:/// POST' can be assigned with `method= "POST"`.
        -:   47:///
        -:   48:/// Given a metric name and a set of labels, time series are frequently
        -:   49:/// identified using this notation:
        -:   50:///
        -:   51:///     <metric name> { < label name >= <label value>, ... }
        -:   52:///
        -:   53:/// It is required to follow the syntax of metric names and labels given by:
        -:   54:/// https://prometheus.io/docs/concepts/data_model/#metric-names-and-labels
        -:   55:///
        -:   56:/// The following metric and label conventions are not required for using
        -:   57:/// Prometheus, but can serve as both a style-guide and a collection of best
        -:   58:/// practices: https://prometheus.io/docs/practices/naming/
        -:   59:///
        -:   60:/// \tparam T One of the metric types Counter, Gauge, Histogram or Summary.
        -:   61:template <typename T>
        -:   62:class PROMETHEUS_CPP_CORE_EXPORT Family : public Collectable {
        -:   63: public:
        -:   64:  /// \brief Create a new metric.
        -:   65:  ///
        -:   66:  /// Every metric is uniquely identified by its name and a set of key-value
        -:   67:  /// pairs, also known as labels. Prometheus's query language allows filtering
        -:   68:  /// and aggregation based on metric name and these labels.
        -:   69:  ///
        -:   70:  /// This example selects all time series that have the `http_requests_total`
        -:   71:  /// metric name:
        -:   72:  ///
        -:   73:  ///     http_requests_total
        -:   74:  ///
        -:   75:  /// It is possible to assign labels to the metric name. These labels are
        -:   76:  /// propagated to each dimensional data added with Add(). For example if a
        -:   77:  /// label `job= "prometheus"` is provided to this constructor, it is possible
        -:   78:  /// to filter this time series with Prometheus's query language by appending
        -:   79:  /// a set of labels to match in curly braces ({})
        -:   80:  ///
        -:   81:  ///     http_requests_total{job= "prometheus"}
        -:   82:  ///
        -:   83:  /// For further information see: [Querying Basics]
        -:   84:  /// (https://prometheus.io/docs/prometheus/latest/querying/basics/)
        -:   85:  ///
        -:   86:  /// \param name Set the metric name.
        -:   87:  /// \param help Set an additional description.
        -:   88:  /// \param constant_labels Assign a set of key-value pairs (= labels) to the
        -:   89:  /// metric. All these labels are propagated to each time series within the
        -:   90:  /// metric.
        -:   91:  /// \throw std::runtime_exception on invalid metric or label names.
        -:   92:  Family(const std::string& name, const std::string& help,
        -:   93:         const Labels& constant_labels);
        -:   94:
        -:   95:  /// \brief Add a new dimensional data.
        -:   96:  ///
        -:   97:  /// Each new set of labels adds a new dimensional data and is exposed in
        -:   98:  /// Prometheus as a time series. It is possible to filter the time series
        -:   99:  /// with Prometheus's query language by appending a set of labels to match in
        -:  100:  /// curly braces ({})
        -:  101:  ///
        -:  102:  ///     http_requests_total{job= "prometheus",method= "POST"}
        -:  103:  ///
        -:  104:  /// \param labels Assign a set of key-value pairs (= labels) to the
        -:  105:  /// dimensional data. The function does nothing, if the same set of labels
        -:  106:  /// already exists.
        -:  107:  /// \param args Arguments are passed to the constructor of metric type T. See
        -:  108:  /// Counter, Gauge, Histogram or Summary for required constructor arguments.
        -:  109:  /// \return Return the newly created dimensional data or - if a same set of
        -:  110:  /// labels already exists - the already existing dimensional data.
        -:  111:  /// \throw std::runtime_exception on invalid label names.
        -:  112:  template <typename... Args>
    #####:  113:  T& Add(const Labels& labels, Args&&... args) {
    #####:  114:    return Add(labels, detail::make_unique<T>(args...));
        -:  115:  }
        -:  116:
        -:  117:  /// \brief Remove the given dimensional data.
        -:  118:  ///
        -:  119:  /// \param metric Dimensional data to be removed. The function does nothing,
        -:  120:  /// if the given metric was not returned by Add().
        -:  121:  void Remove(T* metric);
        -:  122:
        -:  123:  /// \brief Returns true if the dimensional data with the given labels exist
        -:  124:  ///
        -:  125:  /// \param labels A set of key-value pairs (= labels) of the dimensional data.
        -:  126:  bool Has(const Labels& labels) const;
        -:  127:
        -:  128:  /// \brief Returns the name for this family.
        -:  129:  ///
        -:  130:  /// \return The family name.
        -:  131:  const std::string& GetName() const;
        -:  132:
        -:  133:  /// \brief Returns the constant labels for this family.
        -:  134:  ///
        -:  135:  /// \return All constant labels as key-value pairs.
        -:  136:  const Labels& GetConstantLabels() const;
        -:  137:
        -:  138:  /// \brief Returns the current value of each dimensional data.
        -:  139:  ///
        -:  140:  /// Collect is called by the Registry when collecting metrics.
        -:  141:  ///
        -:  142:  /// \return Zero or more samples for each dimensional data.
        -:  143:  std::vector<MetricFamily> Collect() const override;
        -:  144:
        -:  145: private:
        -:  146:  std::unordered_map<Labels, std::unique_ptr<T>, detail::LabelHasher> metrics_;
        -:  147:
        -:  148:  const std::string name_;
        -:  149:  const std::string help_;
        -:  150:  const Labels constant_labels_;
        -:  151:  mutable std::mutex mutex_;
        -:  152:
        -:  153:  ClientMetric CollectMetric(const Labels& labels, T* metric) const;
        -:  154:  T& Add(const Labels& labels, std::unique_ptr<T> object);
        -:  155:};
        -:  156:
        -:  157:}  // namespace prometheus
