        -:    9:namespace prometheus {
        -:   10:
        -:   11:/// \brief A counter metric to represent a monotonically increasing value.
        -:   12:///
        -:   13:/// This class represents the metric type counter:
        -:   14:/// https://prometheus.io/docs/concepts/metric_types/#counter
        -:   15:///
        -:   16:/// The value of the counter can only increase. Example of counters are:
        -:   17:/// - the number of requests served
        -:   18:/// - tasks completed
        -:   19:/// - errors
        -:   20:///
        -:   21:/// Do not use a counter to expose a value that can decrease - instead use a
        -:   22:/// Gauge.
        -:   23:///
        -:   24:/// The class is thread-safe. No concurrent call to any API of this type causes
        -:   25:/// a data race.
        -:   26:class PROMETHEUS_CPP_CORE_EXPORT Counter {
        -:   27: public:
        -:   28:  static const MetricType metric_type{MetricType::Counter};
        -:   29:
        -:   30:  /// \brief Create a counter that starts at 0.
    #####:   31:  Counter() = default;
call    0 never executed
branch  1 never executed (fallthrough)
branch  2 never executed (throw)
        -:   32:
        -:   33:  /// \brief Increment the counter by 1.
        -:   34:  void Increment();
        -:   35:
        -:   36:  /// \brief Increment the counter by a given amount.
        -:   37:  ///
        -:   38:  /// The counter will not change if the given amount is negative.
        -:   39:  void Increment(double);
        -:   40:
        -:   41:  /// \brief Reset the counter to 0
        -:   42:  void Reset();
        -:   43:
        -:   44:  /// \brief Get the current value of the counter.
        -:   45:  double Value() const;
        -:   46:
        -:   47:  /// \brief Get the current value of the counter.
        -:   48:  ///
        -:   49:  /// Collect is called by the Registry when collecting metrics.
        -:   50:  ClientMetric Collect() const;
        -:   51:
        -:   52: private:
        -:   53:  Gauge gauge_{0.0};
        -:   54:};
        -:   55:
        -:   56:/// \brief Return a builder to configure and register a Counter metric.
        -:   57:///
        -:   58:/// @copydetails Family<>::Family()
        -:   59:///
        -:   60:/// Example usage:
        -:   61:///
        -:   62:/// \code
        -:   63:/// auto registry = std::make_shared<Registry>();
        -:   64:/// auto& counter_family = prometheus::BuildCounter()
        -:   65:///                            .Name("some_name")
        -:   66:///                            .Help("Additional description.")
        -:   67:///                            .Labels({{"key", "value"}})
        -:   68:///                            .Register(*registry);
        -:   69:///
        -:   70:/// ...
        -:   71:/// \endcode
        -:   72:///
        -:   73:/// \return An object of unspecified type T, i.e., an implementation detail
        -:   74:/// except that it has the following members:
        -:   75:///
        -:   76:/// - Name(const std::string&) to set the metric name,
        -:   77:/// - Help(const std::string&) to set an additional description.
        -:   78:/// - Labels(const Labels&) to assign a set of
        -:   79:///   key-value pairs (= labels) to the metric.
        -:   80:///
        -:   81:/// To finish the configuration of the Counter metric, register it with
        -:   82:/// Register(Registry&).
        -:   83:PROMETHEUS_CPP_CORE_EXPORT detail::Builder<Counter> BuildCounter();
